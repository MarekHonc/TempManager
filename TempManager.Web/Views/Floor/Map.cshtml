@using TempManager.Web.Localization
@model MainViewModel

<script src="~/js/pan.and.zoom.js"></script>

<style>
	body {
		margin: 0;
		overflow: hidden;
	}

	#map-app {
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		position: relative;
		touch-action: none;
		cursor: grab;
	}

	#content {
		position: absolute;
		top: 0;
		left: 0;
		transform-origin: top left;
		transform: translate(0px, 0px) scale(1);
	}

	img {
		user-select: none;
		pointer-events: none;
	}

	.room {
		position: absolute;
		z-index: 9;
		background-color: white;
	}
</style>

<div id="map-app">
	@await Html.PartialAsync("_Loader")

	<div id="content">
		@if (Model.FloorViewExists)
		{
			await Html.RenderPartialAsync("../Floor/" + Model.SelectedFloor.MapViewName, Model);
		}
		else
		{
			<div class="container">
				<div class="row text-center mt-5">
					<h5>@Resources.NoMap</h5>
				</div>
			</div>
		}
	</div>
</div>

<script type="text/javascript">
	@* Inicializace pohyblivého pozadí *@
	panAndZoom("map-app", "content");

	@* Inicializace modelu *@
	var model = new appModel({
		roomsUrl: "@Url.Action("GetRooms", "Floor", new { friendlyId = Model.SelectedFloor.FriendlyId })",
		saveFavoriteUrl: "@Url.Action("SaveToFavorite", "Floor")",
		setTemperatureUrl: "@Url.Action("SetTemperature", "Floor")",
		group: "@Model.SelectedFloor.FriendlyId"
	});

	ko.applyBindings(model, document.getElementById("map-app"));
</script>