@using TempManager.BL.Services
@using TempManager.Web.Localization
@model MainViewModel

@if (Model.IsOnline)
{
	ViewData["Title"] = Resources.Offline_Title;
	await Html.RenderPartialAsync("../Home/Offilne", Model);
	return;
}

@{
	ViewData["Title"] = Resources.List;
}

<div id="list-app" class="container mt-5">
	@await Html.PartialAsync("_Loader")

	<div class="row justify-content-between">
		<h3 class="col-auto">@Resources.Rooms</h3>
		<div class="col-auto row align-items-center">
			<div class="col-auto">
				<input class="form-check-input" data-bind="checked: onlyFavorites" type="checkbox" id="only-favorites">
				<label class="form-check-label" for="only-favorites">
					@Resources.OnlyFavorites
				</label>
			</div>
			<div class="col-auto">
				<input data-bind="value: searchTerm, valueUpdate: 'afterkeydown'" class="form-control" type="search" placeholder="@Resources.Search" aria-label="@Resources.Search">
			</div>
		</div>
	</div>
	<!-- ko if: filteredRooms().length == 0 -->
	<div class="row">
		<p>@Resources.NoRooms</p>
	</div>
	<!-- /ko-->
	<!-- ko if: filteredRooms().length > 0 -->
	<div class="table-responsive">
		<table class="table table-bordered table-striped">
			<caption>@Resources.Rooms</caption>
			<thead>
				<tr>
					<th>@Resources.Room</th>
					<th>@Resources.Floor</th>
					<th class="temperature">@Html.Raw(Resources.Temperature)</th>
					<th class="temperature">@Html.Raw(Resources.DesiredTempereture)</th>
					<th class="temperature">@Resources.Rh</th>
					<th></th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				<!-- ko foreach: filteredRooms -->
				<tr>
					<td data-bind="text: name"></td>
					<td data-bind="text: floorName"></td>
					<td class="temperature" data-bind="text: temperature"></td>
					<!-- ko if: hasRightToEdit -->
					<td class="temperature setter">
						<span class="inner">
							<span data-bind="click: function() { changeTemperature(-1); }, css: { 'disabled' : !canDecreaseTemperature() }" class="temperature-control minus"></span>
							<span data-bind="text: desiredTemperature().inputValue, enabled: hasRightToEdit"></span>
							<span data-bind="click: function() { changeTemperature(1); }, css: { 'disabled' : !canIncreaseTemperature() }" class="temperature-control plus"></span>
						</span>
					</td>
					<!-- /ko -->
					<!-- ko ifnot: hasRightToEdit -->
					<td class="temperature" data-bind="text: desiredTemperature().dsValue"></td>
					<!-- /ko -->
					<td class="temperature" data-bind="text: rh"></td>
					<td class="center icon"><span data-bind="css: { 'heat': valveOpen(), 'freeze': !valveOpen() }"></span></td>
					<td class="center icon"><span class="star" data-bind="css: { 'filled': isFavorite }, click: toggleFavorite"></span></td>
				</tr>
				<!-- /ko -->
			</tbody>
		</table>
	</div>
	<!-- /ko -->
</div>

<script type="text/javascript">
	var model = new appModel({
		roomsUrl: "@Url.Action("GetRooms", "List")",
		saveFavoriteUrl: "@Url.Action("SaveToFavorite", "Room")",
		setTemperatureUrl: "@Url.Action("SetTemperature", "Room")",
		group: "List",
		step: 0.5,
		minValue: @RoomService.MinTemperature,
		maxValue: @RoomService.MaxTemperature,
	});

	ko.applyBindings(model, document.getElementById("list-app"));
</script>