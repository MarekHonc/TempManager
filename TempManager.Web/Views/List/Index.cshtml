@using TempManager.BL.Services
@using TempManager.Web.Localization
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model MainViewModel

@if (Model.IsOnline)
{
	ViewData["Title"] = Resources.Offline_Title;
	await Html.RenderPartialAsync("../Home/Offilne", Model);
	return;
}

@{
	ViewData["Title"] = Resources.List;
}

<div id="list-app" class="container mt-5">
	@await Html.PartialAsync("_Loader")

	<div class="row justify-content-between">
		<h3 class="col-auto">@Resources.Rooms</h3>
		<div class="col-auto">
			<div class="row align-items-center">
				<div class="col-auto">
					<input class="form-check-input" data-bind="checked: onlyFavorites" type="checkbox" id="only-favorites">
					<label class="form-check-label" for="only-favorites">
						@Resources.OnlyFavorites
					</label>
				</div>
				<div class="col-auto">
					<input data-bind="value: searchTerm, valueUpdate: 'afterkeydown'" class="form-control" type="search" placeholder="@Resources.Search" aria-label="@Resources.Search">
				</div>
			</div>
		</div>
	</div>
	<!-- ko if: filteredRooms().length == 0 -->
	<div class="row">
		<div class="col-12">
			<div class="alert alert-secondary" role="alert">
				<div>@Resources.NoRooms</div>
				<!-- ko if: rooms.items().length == 0 -->
				<div>
					@Html.Raw(string.Format(Resources.ContactAdministrator, Configuration["AdminEmail"]))
				</div>
				<!-- /ko -->
			</div>
		</div>
	</div>
	<!-- /ko-->
	<!-- ko if: filteredRooms().length > 0 -->
	<div class="table-responsive">
		<table class="table table-bordered table-striped">
			<caption>@Resources.Rooms</caption>
			<thead>
				<tr>
					<th>@Resources.Room</th>
					<th class="hidden-md">@Resources.Floor</th>
					<th class="numeric-value">@Html.Raw(Resources.Temperature)</th>
					<th class="numeric-value">@Html.Raw(Resources.DesiredTempereture)</th>
					<th class="numeric-value hidden-xxs">@Resources.Rh</th>
					<!-- ko if: showCo2 -->
					<th class="numeric-value">@Resources.CO2</th>
					<!-- /ko -->
					<th class="numeric-value hidden-xs">@Resources.ValveOpen</th>
					<th class="hidden-xs"></th>
				</tr>
			</thead>
			<tbody>
				<!-- ko foreach: filteredRooms -->
				<tr data-bind="css: { 'error' : isError }">
					<td>
						<span class="name">
							<span data-bind="text: name"></span>
							<span data-bind="text: description"></span>
						</span>
					</td>
					<td class="hidden-md" data-bind="text: floorName"></td>
					<td class="numeric-value" data-bind="text: temperature"></td>
					<!-- ko if: hasRightToEdit -->
					<td class="numeric-value setter">
						<span class="inner">
							<span class="control minus" data-bind="
								event: { mousedown: startDecrement, mouseup: stopChange, mouseleave: stopChange, click: function() { changeTemperature(-1, true); } },
								css: { 'disabled' : !canDecreaseTemperature() }">
							</span>
							<span data-bind="text: desiredTemperature().inputValue, enabled: hasRightToEdit"></span>
							<span class="control plus" data-bind="
								event: { mousedown: startIncrement, mouseup: stopChange, mouseleave: stopChange, click: function() { changeTemperature(1, true); } },
								css: { 'disabled' : !canIncreaseTemperature() }">
							</span>
						</span>
					</td>
					<!-- /ko -->
					<!-- ko ifnot: hasRightToEdit -->
					<td class="numeric-value setter">
						<span class="inner">
							<span class="control minus disabled"></span>
							<span data-bind="text: desiredTemperature().dsValue"></span>
							<span class="control plus disabled"></span>
						</span>
					</td>
					<!-- /ko -->
					<td class="icon gauge hidden-xxs">
						<span>
							<span class="gauge-container" data-bind="gauge: rh">
								@await Html.PartialAsync("_Gauge")
							</span>
						</span>
					</td>
					<!-- ko if: $root.showCo2 -->
					<td class="icon gauge">
						<span data-bind="visible: co2.current() > 0">
							<span class="gauge-container" data-bind="gauge: co2">
								@await Html.PartialAsync("_Gauge")
							</span>
						</span>
					</td>
					<!-- /ko -->
					<td class="icon gauge hidden-xs">
						<span>
							<span class="gauge-container" data-bind="gauge: valveOpen">
								@await Html.PartialAsync("_Gauge")
							</span>
						</span>
					</td>
					<td class="icon hidden-xs">
						<span class="center">
							<span class="star" data-bind="css: { 'filled': isFavorite }, click: toggleFavorite"></span>
						</span>
					</td>
				</tr>
				<!-- /ko -->
			</tbody>
		</table>
	</div>
	<!-- /ko -->
</div>

<script type="text/javascript">
	var model = new appModel({
		roomsUrl: "@Url.Action("GetRooms", "List")",
		saveFavoriteUrl: "@Url.Action("SaveToFavorite", "Room")",
		setTemperatureUrl: "@Url.Action("SetTemperature", "Room")",
		group: "List",
		step: 0.5,
		minValue: @RoomService.MinTemperature,
		maxValue: @RoomService.MaxTemperature,
		localization: {
			success: "@Html.Raw(Resources.Success)",
			successDescription: "@Html.Raw(Resources.SuccessDescription)",
			error: "@Html.Raw(Resources.Error)",
			errorDescription: "@Html.Raw(Resources.ErrorDescription)"
		}
	});

	ko.applyBindings(model, document.getElementById("list-app"));
</script>