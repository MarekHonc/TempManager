<svg class="gauge-svg" width="50" height="50">
	<!-- Skupina otáčí pouze kruhy, takže gauge začíná od spodní části (6 hodin) -->
	<g class="gauge-group" transform="rotate(90, 25, 25)">
		<circle class="background-circle" cx="25" cy="25" r="20"></circle>
		<circle class="progress-circle" cx="25" cy="25" r="20" stroke-dasharray="125.66" stroke-dashoffset="125.66"></circle>
	</g>
	<!-- Text zůstává vodorovný -->
	<text class="gauge-text" x="24" y="30">0</text>
</svg>