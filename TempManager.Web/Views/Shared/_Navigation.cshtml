@using TempManager.Web.Localization
@using TempManager.Common
@model BaseViewModel

@{
	var mainModel = Model as MainViewModel;
}

@* Mapa jako jediná má jiné zobrazení. *@
@if (mainModel is { FloorViewType: FloorViewType.Map })
{
	<div class="navbar-dark" id="nav-fixed">
		<button class="navbar-toggler btn" type="button" data-bs-toggle="offcanvas" href="#main-nav" role="button">
			<span class="navbar-toggler-icon"></span>
		</button>
	</div>

	<div id="view-switcher">
		@await Html.PartialAsync("_UserMenu", Model)
	</div>
}
else
{
	<div class="navbar-dark p-3 d-flex justify-content-between" id="nav-banner">
		<button class="navbar-toggler btn" type="button" data-bs-toggle="offcanvas" href="#main-nav" role="button">
			<span class="navbar-toggler-icon"></span>
		</button>
		
		@await Html.PartialAsync("_UserMenu", Model)
	</div>
}

<div class="offcanvas offcanvas-start sliding-menu" tabindex="-1" id="main-nav">
	<div class="offcanvas-header flex-row-reverse">
		<button type="button" class="btn btn-close btn-close-white text-reset" data-bs-dismiss="offcanvas" aria-label="@Resources.Close"></button>
	</div>
	<div class="offcanvas-body">
		<div class="list-group list-group-flush">
			@foreach (var floor in Model.Floors)
			{
				var isSelected = Model.WebLocation == WebLocation.Floor && floor.FriendlyId == Model.SelectedFloor.FriendlyId;

				<a href="@Url.Action("Floor", "Home", new { floor.FriendlyId })"
				class="list-group-item list-group-item-action @(isSelected ? "active" : string.Empty)" @(isSelected ? "aria-current=\"true\"" : string.Empty)>
					@floor.Name
				</a>
			}

			@{
				var isFeedbackSelected = Model.WebLocation == WebLocation.FeedBackForm;
			}

			<a href="@Url.Action("Index", "Feedback")"
			class="list-group-item list-group-item-action @(isFeedbackSelected ? "active" : string.Empty)" @(isFeedbackSelected ? "aria-current=\"true\"" : string.Empty)>
				@Resources.Feedback
			</a>

			@if (Model.CurrentUser.IsAdmin)
			{
				<a href="@Url.Action("Index", "AdminFloor", new { area = "Admin" })"
				class="list-group-item list-group-item-action">
					@Resources.Admin
				</a>
			}
		</div>
	</div>
</div>