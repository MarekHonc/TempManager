@using TempManager.Web.Localization
@model MainViewModel

@if (Model.IsOnline)
{
	ViewData["Title"] = Resources.Offline_Title;
	await Html.RenderPartialAsync("../Home/Offilne", Model);
	return;
}

@{
	ViewData["Title"] = Model.SelectedFloor.Name;
}

<style>
	body {
		margin: 0;
		overflow: hidden;
		background-color: white;
	}
</style>

<div id="map-app">
	@await Html.PartialAsync("_Loader")

	<div id="content">
		@if (Model.FloorViewExists)
		{
			<img src="@Model.SelectedFloor.MapName" alt="@Model.SelectedFloor.Name">

			<!-- ko foreach: filteredRooms -->
			<!-- ko if: x() && y() -->
			<div class="room text-center" data-bind="style: { top: y, left: x }">
				<h5 class="mb-0" data-bind="text: name"></h5>
				<span class="mb-0" data-bind="text: temperatureFormatted"></span>
			</div>
			<!-- /ko -->
			<!-- /ko -->
		}
		else
		{
			<div class="container">
				<div class="row text-center mt-5">
					<h5>@Resources.NoMap</h5>
				</div>
			</div>
		}
	</div>
</div>

<script type="text/javascript">
	@* Inicializace pohyblivého pozadí *@
	panAndZoom("map-app", "content");

	@* Inicializace modelu *@
	var model = new appModel({
		roomsUrl: "@Url.Action("GetRooms", "Map", new { friendlyId = Model.SelectedFloor.FriendlyId })",
		saveFavoriteUrl: "@Url.Action("SaveToFavorite", "Room")",
		setTemperatureUrl: "@Url.Action("SetTemperature", "Room")",
		group: "@Model.SelectedFloor.FriendlyId"
	});

	ko.applyBindings(model, document.getElementById("map-app"));
</script>