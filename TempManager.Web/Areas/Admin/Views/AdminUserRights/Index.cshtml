@using TempManager.Web.Areas.Admin.Localization
@model TempManager.Web.Areas.Admin.Models.AdminListViewModel<TempManager.DL.Entities.User>

@{
	ViewData["Title"] = AdminResources.UserRights;
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>@AdminResources.UserRights</h2>

@* TODO:
	Editační tabulka s oprávněními - smáznout někoho - nevidím, vidím + můžu měnit, pouze vidím, co2 nejvíc - HOTOVO, až na CO2
*@

<div class="table-responsive">
	<table class="table table-bordered table-striped">
		<caption>@AdminResources.UserRights</caption>
		<thead>
			<tr>
				<th>@AdminResources.UserName</th>
				<th>@AdminResources.FirstName</th>
				<th>@AdminResources.LastName</th>
				<th>@AdminResources.CanViewAllRooms</th>
				<th>@AdminResources.IsAdmin</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.Items)
			{
				<tr>
					<td>
						@Html.ActionLink(item.UserName, "Edit", new { id = item.Id })
					</td>
					<td>@item.FirstName</td>
					<td>@item.LastName</td>
					<td>@(item.CanViewAllRooms ? AdminResources.Yes : AdminResources.No)</td>
					<td>@(item.IsAdmin ? AdminResources.Yes : AdminResources.No)</td>
				</tr>
			}
		</tbody>
	</table>
</div>