@model TempManager.Web.Areas.Admin.Models.AdminBaseViewModel

<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>
	<link rel="stylesheet" href="/css/bundle.css" />
	<link rel="stylesheet" href="/css/bundle-admin.css" />
	
	<script src="/js/libraries"></script>
	<script src="/js/autocomplete"></script>
	<script src="/js/front-end-admin"></script>

	@await RenderSectionAsync("Scripts", required: false)
</head>
<body>
	@await Html.PartialAsync("_Navigation", Model)

	<main role="main" class="pb-3 container">
		@RenderBody()
	</main>

	<footer class="footer text-muted text-center">
		<div class="container">
			&copy; TUL @DateTime.Today.Year
		</div>
	</footer>
</body>
</html>