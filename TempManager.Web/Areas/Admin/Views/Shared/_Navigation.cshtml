@using TempManager.Common
@using TempManager.Web.Areas.Admin.Localization
@model TempManager.Web.Areas.Admin.Models.AdminBaseViewModel

<nav class="navbar navbar-expand-md navbar-dark mb-3 pb-3" id="nav-banner">
	<div class="container">
		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse" id="navbarSupportedContent">
			<ul class="navbar-nav me-auto mb-2 mb-md-0">
				<li class="nav-item">
					<a class="nav-link" href="/">@AdminResources.Home</a>
				</li>
				<li class="nav-item">
					<a class="nav-link @(Model.AdminWebLocation == AdminWebLocation.Floors ? "active" : string.Empty)" href="@Url.Action("Index", "AdminFloor")">@AdminResources.Floors</a>
				</li>
				<li class="nav-item">
					<a class="nav-link @(Model.AdminWebLocation == AdminWebLocation.Rooms ? "active" : string.Empty)" href="@Url.Action("Index", "AdminRoom")">@AdminResources.Rooms</a>
				</li>
				<li class="nav-item">
					<a class="nav-link @(Model.AdminWebLocation == AdminWebLocation.SetTemperature ? "active" : string.Empty)" href="@Url.Action("Index", "AdminSetTemperature")">@AdminResources.SetTemperature</a>
				</li>
				<li class="nav-item">
					<a class="nav-link @(Model.AdminWebLocation == AdminWebLocation.RoomValues ? "active" : string.Empty)" href="@Url.Action("Index", "AdminRoomValues")">@AdminResources.RoomValues</a>
				</li>
				<li class="nav-item">
					<a class="nav-link @(Model.AdminWebLocation == AdminWebLocation.UserRights ? "active" : string.Empty)" href="@Url.Action("Index", "AdminUserRights")">@AdminResources.UserRights</a>
				</li>
