@using TempManager.Web.Areas.Admin.Localization
@model TempManager.Web.Areas.Admin.Models.AdminListViewModel<TempManager.DL.Entities.Floor>

@{
	ViewData["Title"] = AdminResources.Floors;
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>@AdminResources.Floors</h2>

<div class="table-responsive">
	<table class="table table-bordered table-striped">
		<caption>@AdminResources.Floors</caption>
		<thead>
			<tr>
				<th class="w50"></th>
				<th>@AdminResources.Name</th>
				<th>@AdminResources.FriendlyId</th>
				<th>@AdminResources.ExternalId</th>
				<th>@AdminResources.MapViewName</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.Items)
			{
				<tr>
					<td>
						<span data-floor="@item.Id" class="eye admin-icon @(item.IsHidden ? "hidden" : "visible")"></span>
					</td>
					<td>
						@Html.ActionLink(item.Name, "Edit", new { id = item.Id })
					</td>
					<td>@item.FriendlyId</td>
					<td>@item.ExternalId</td>
					<td>@item.MapViewName</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<script type="text/javascript">
	$(document).ready(function() {
		$(".eye").on("click", function() {
			var $this = $(this);

			$.ajax({
				method: "POST",
				url: "@Url.Action("SetVisible", "AdminFloor")",
				data: {
					floorId: $this.attr("data-floor"),
					isVisible: $this.hasClass("hidden")
				},
				success: function() {
					$this.toggleClass("hidden");
					$this.toggleClass("visible");
				}
			});
		});
	});
</script>