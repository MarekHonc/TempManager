@using TempManager.Web.Areas.Admin.Localization
@model TempManager.Web.Areas.Admin.Models.AdminBaseViewModel

@{
	ViewData["Title"] = AdminResources.SetTemperature;
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section Scripts
{
	<script src="~/js/models/auto.comlete.model.js"></script>
	<script src="~/js/models/app.history.model.js"></script>
}

<h2>@AdminResources.SetTemperature</h2>

<div id="history-app">
	<div class="row d-flex flex-row-reverse">
		<div class="col-auto mb-3">
			<div class="card">
				<div class="card-body d-flex justify-content-between">
					<input data-bind="visible: !userId()" id="auto-complete-user" class="form-control" placeholder="@AdminResources.SearchUsers" />
					<!-- ko with: userAutoComplete -->
					<!-- ko foreach: data.items -->
					<span data-bind="text: value"></span>
					<button data-bind="click: function() { $parent.remove($data); }" class="btn btn-close align-self-center"></button>
					<!-- /ko -->
					<!-- /ko -->
				</div>
			</div>
		</div>
		<div class="col-auto mb-3">
			<div class="card">
				<div class="card-body d-flex justify-content-between">
					<input data-bind="visible: !roomId()" id="auto-complete-room" class="form-control" placeholder="@AdminResources.SearchRooms" />
					<!-- ko with: roomAutoComplete -->
					<!-- ko foreach: data.items -->
					<span class="form-control" data-bind="text: value"></span>
					<button data-bind="click: function() { $parent.remove($data); }" class="btn btn-close align-self-center"></button>
					<!-- /ko -->
					<!-- /ko -->
				</div>
			</div>
		</div>
	</div>

	<div class="table-responsive">
		<table class="table table-bordered table-striped">
			<caption>@AdminResources.SetTemperature</caption>
			<thead>
				<tr>
					<th>@AdminResources.Date</th>
					<th>@AdminResources.User</th>
					<th>@AdminResources.Room</th>
					<th class="temperature">@Html.Raw(AdminResources.SetTemperatureTo)</th>
					<th>@AdminResources.Result</th>
				</tr>
			</thead>
			<tbody>
				<!-- ko foreach: rows -->
				<tr>
					<td data-bind="text: date"></td>
					<td data-bind="text: userName"></td>
					<td data-bind="text: roomName"></td>
					<td class="temperature" data-bind="text: newTemperature"></td>
					<td data-bind="text: result"></td>
				</tr>
				<!-- /ko -->
			</tbody>
		</table>
	</div>
	<!-- ko if: hasNext -->
	<div class="row text-center">
		<a href="_" data-bind="click: loadNext">@AdminResources.NextPage</a>
	</div>
	<!-- /ko -->
</div>

<div id="auto-complete-holder"></div>

<script type="text/javascript">
	let model = new historyModel({
		url: "@Url.Action("List", "AdminSetTemperature")",
		userAutoCompleteUrl: "@Url.Action("AutoCompleteUser", "AdminRoom")",
		roomAutoCompleteUrl: "@Url.Action("AutoCompleteRoom", "AdminUserRights")"
	});
	ko.applyBindings(model, document.getElementById("history-app"));
</script>