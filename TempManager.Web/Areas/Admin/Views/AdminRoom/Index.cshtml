@using TempManager.Web.Areas.Admin.Localization
@model TempManager.Web.Areas.Admin.Models.AdminListViewModel<TempManager.DL.Entities.Room>

@{
	ViewData["Title"] = AdminResources.Rooms;
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
	function slidingModel() {
		var self = this;

		self.isVisible = ko.observable(false);

		self.toggleVisible = function() {
			self.isVisible(!self.isVisible());
		}
	}
</script>

<h2>@AdminResources.Rooms</h2>

@foreach (var group in Model.Items.GroupBy(i => i.FloorId))
{
	<div id="slide-@group.Key">
		<div data-bind="click: toggleVisible, css: { 'down' : isVisible() }" class="alert alert-secondary toggle-visibility">
			<h3 class="room-header">@group.First().Floor.Name</h3>
		</div>
		<div class="rooms table-responsive" data-bind="slideVisible: isVisible">
			<table class="table table-bordered table-striped">
				<caption>@group.First().Floor.Name</caption>
				<thead>
				<tr>
					<th class="w50"></th>
					<th>@AdminResources.Name</th>
					<th>X/Y</th>
					<th>@AdminResources.ExternalId</th>
				</tr>
				</thead>
				<tbody>
					@foreach (var item in group.OrderBy(i => i.Name))
					{
						<tr>
							<td>
								<span data-room="@item.Id" class="eye admin-icon @(item.IsHidden ? "hidden" : "visible")"></span>
							</td>
							<td>
								@Html.ActionLink(item.Name, "Edit", new { id = item.Id })
							</td>
							<td>
								@if (item.XPosition.HasValue)
								{
									<text>@item.XPosition/@item.YPosition</text>
								}
							</td>
							<td>@item.ExternalId</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<script type="text/javascript">
		ko.applyBindings(new slidingModel(), document.getElementById("slide-@group.Key"));
	</script>
}

<script type="text/javascript">
	$(document).ready(function() {
		$(".eye").on("click", function() {
			var $this = $(this);

			$.ajax({
				method: "POST",
				url: "@Url.Action("SetVisible", "AdminRoom")",
				data: {
					floorId: $this.attr("data-floor"),
					isVisible: $this.hasClass("hidden")
				},
				success: function() {
					$this.toggleClass("hidden");
					$this.toggleClass("visible");
				}
			});
		});
	});
</script>