@using TempManager.Web.Areas.Admin.Localization
@using TempManager.Web.Code
@model TempManager.Web.Areas.Admin.Models.RoomEditorViewModel

@{
	ViewData["Title"] = string.Format(AdminResources.RoomTitle, Model.Name);
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section Scripts
{
	<script src="~/js/models/auto.complete.rights.model.js"></script>
}

<div class="row d-flex justify-content-center">
	<div class="col-md-6 card">
		<div class="card-body">
			<h3 class="card-title">@Model.Name</h3>

			<form asp-action="Edit" asp-controller="AdminRoom" asp-area="Admin" method="POST">
				<div class="text-danger">
					@Html.ValidationSummary(excludePropertyErrors: false)
				</div>
				<input type="hidden" asp-for="Id" />
				<div class="form-group mb-3">
					@Html.LabelFor(m => m.Name, new { @class = "control-label" })
					@Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
				</div>
				<div class="form-group mb-3">
					@Html.LabelFor(m => m.X, new { @class = "control-label" })
					@Html.TextBoxFor(m => m.X, new { @class = "form-control", type = "number" })
				</div>
				<div class="form-group mb-3">
					@Html.LabelFor(m => m.Y, new { @class = "control-label" })
					@Html.TextBoxFor(m => m.Y, new { @class = "form-control", type = "number" })
				</div>
				<div id="autocomplete-app" class="mb-3">
					<label class="control-label" for="auto-complete">@AdminResources.Users</label>
					<input id="auto-complete" class="form-control" placeholder="@AdminResources.SearchUsers" />

					<!-- ko foreach: data.items -->
					<input type="hidden" data-bind="value: key, attr: { name: '@(Html.NameFor(m => m.AuthorizedUsers))[-1].Key'.replace('-1', $index()) }" />
					<input type="hidden" data-bind="value: value().title, attr: { name: '@(Html.NameFor(m => m.AuthorizedUsers))[-1].Value.Title'.replace('-1', $index()) }" />
					<input type="hidden" data-bind="value: value().canEdit, attr: { name: '@(Html.NameFor(m => m.AuthorizedUsers))[-1].Value.CanEdit'.replace('-1', $index()) }" />
					<input type="hidden" data-bind="value: value().canView, attr: { name: '@(Html.NameFor(m => m.AuthorizedUsers))[-1].Value.CanView'.replace('-1', $index()) }" />

					<div class="row mt-1">
						<div class="col-12">
							<div class="card">
								<div class="card-body d-flex justify-content-between">
									<div class="d-flex flex-column">
										<strong data-bind="text: value().title"></strong>
										<label class="form-check-label">
											<input type="checkbox" data-bind="checked: value().canView" class="form-check-input" />
											@AdminResources.CanRead
										</label>
										<label class="form-check-label">
											<input type="checkbox" data-bind="checked: value().canEdit" class="form-check-input" />
											@AdminResources.CanWrite
										</label>
									</div>
									<button type="button" data-bind="click: function() { $parent.remove($data); }" class="btn btn-close"></button>
								</div>
							</div>
						</div>
					</div>
					<!-- /ko -->
				</div>
				<div class="form-group float-end">
					@Html.ActionLink(AdminResources.Back, "Index", "AdminRoom", null, new { @class = "m-2" })
					<input type="submit" value="@AdminResources.Save" class="btn btn-primary" />
				</div>
			</form>
		</div>
	</div>
</div>

<div id="auto-complete-holder"></div>

<script type="text/javascript">
	let model = new autoCompleteRightViewModel({
		values: @Html.Raw(Model.AuthorizedUsers.ToJson()),
		autoComplete: "#auto-complete",
		autoCompleteHolder: "#auto-complete-holder",
		autoCompleteUrl: "@Url.Action("AutoCompleteUser", "AdminRoom")"
	});
	ko.applyBindings(model, document.getElementById("autocomplete-app"));
</script>